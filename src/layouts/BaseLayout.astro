---
import { siteContent } from "../data/siteContent";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  current?: "home" | "projects";
  image?: string;
};

const { title, description, current = "home", image = "/og.svg" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost:5173");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonical).toString()} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body data-page={current}>
    <div class="cursor-light" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><i></i></div>

    <header class="site-header" data-header>
      <a class="wordmark" href="/" aria-label="叶峻枫首页">
        <strong>{siteContent.brand.name}</strong>
        <span>/ {siteContent.brand.chinese}</span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        <a href={current === "home" ? "#projects" : "/#projects"}>项目</a>
        <a href={current === "home" ? "#experience" : "/#experience"}>经历</a>
        <a href={current === "home" ? "#capabilities" : "/#capabilities"}>能力</a>
        <a href={current === "home" ? "#contact" : "/#contact"}>联系</a>
      </nav>
      <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false">
        <span aria-hidden="true"></span> 动效
      </button>
    </header>

    <main><slot /></main>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
