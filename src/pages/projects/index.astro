---
import ProjectCard from "../../components/ProjectCard.astro";
import { categoryLabels, projects } from "../../data/projects";
import { siteContent } from "../../data/siteContent";
import BaseLayout from "../../layouts/BaseLayout.astro";
const categories = Object.entries(categoryLabels);
---

<BaseLayout title={siteContent.pages.projects.title} description={siteContent.pages.projects.description} current="projects">
  <section class="project-hero" aria-labelledby="project-title">
    <div class="project-hero-inner" data-reveal>
      <p class="section-label">PROJECT ARCHIVE / 2026</p>
      <h1 id="project-title">七个系统，<br />七种复杂度。</h1>
      <p>从模型网关、视频创作与量化研究，到文档审评、制造协同、仓储管理和求职 Agent。所有可见界面都来自真实项目，架构与数据均标注公开边界。</p>
      <div class="hero-actions"><a class="button button-primary" href="/#projects">返回精选项目 <i>↙</i></a></div>
    </div>
  </section>

  <section class="section project-library" aria-labelledby="library-title">
    <div class="section-heading" data-reveal>
      <p class="section-label">ALL WORK</p><h2 id="library-title">项目档案</h2>
    </div>
    <div class="library-tools" data-reveal>
      <label class="project-search"><span>搜索</span><input type="search" placeholder="项目 / 技术栈" data-project-search /></label>
      <div class="filters" aria-label="项目筛选">
        {categories.map(([value, label], index) => <button class:list={["filter-button", { "is-active": index === 0 }]} type="button" data-filter={value}>{label}</button>)}
      </div>
    </div>
    <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
  </section>
</BaseLayout>
