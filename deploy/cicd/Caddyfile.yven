yven.0000238.xyz {
    encode zstd gzip

    reverse_proxy yven-site-web:8080 {
        health_uri /healthz
        health_interval 30s
        health_timeout 5s
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}
